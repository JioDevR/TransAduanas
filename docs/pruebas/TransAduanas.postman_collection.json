{
  "info": {
    "name": "TransAduanas Pruebas funcionales pendientes",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Preparada, no ejecutada. Usar exclusivamente una base QA. CP21 produce baja lógica, no eliminación física."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8085"
    },
    {
      "key": "username",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "documentoQA",
      "value": "20999999991"
    },
    {
      "key": "idClienteQA",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Salud del backend",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/health",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Estado UP\",()=>pm.expect(pm.response.json().data.status).to.eql(\"UP\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Login con usuario de prueba",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"{{username}}\", \"password\": \"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const j=pm.response.json(); pm.test(\"Token presente\",()=>pm.expect(j.data.token).to.be.a(\"string\").and.not.empty); if(pm.response.code===200) pm.collectionVariables.set(\"token\",j.data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "CP21 Crear cliente exclusivo de prueba",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/clientes",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"tipoDocumento\": \"RUC\", \"numeroDocumento\": \"{{documentoQA}}\", \"razonSocial\": \"QA TransAduanas\", \"correoContacto\": \"qa@example.com\", \"esProspecto\": true, \"estadoCliente\": \"PROSPECTO\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const j=pm.response.json(); if(pm.response.code===201)pm.collectionVariables.set(\"idClienteQA\",j.data.idCliente);"
            ]
          }
        }
      ]
    },
    {
      "name": "CP21 Leer cliente",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/clientes/{{idClienteQA}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Mismo cliente\",()=>pm.expect(String(pm.response.json().data.idCliente)).to.eql(pm.collectionVariables.get(\"idClienteQA\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "CP21 Actualizar cliente",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/clientes/{{idClienteQA}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"tipoDocumento\": \"RUC\", \"numeroDocumento\": \"{{documentoQA}}\", \"razonSocial\": \"QA TransAduanas actualizado\", \"correoContacto\": \"qa@example.com\", \"esProspecto\": true, \"estadoCliente\": \"PROSPECTO\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Actualización\",()=>pm.expect(pm.response.json().data.razonSocial).to.eql(\"QA TransAduanas actualizado\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "CP21 Baja lógica cliente QA",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/v1/clientes/{{idClienteQA}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "CP21 Verificar baja lógica",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/clientes/{{idClienteQA}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Inactivo\",()=>pm.expect(pm.response.json().data.estadoActivo).to.eql(false));"
            ]
          }
        }
      ]
    },
    {
      "name": "CP22 Correo inválido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/clientes",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"tipoDocumento\": \"RUC\", \"numeroDocumento\": \"{{documentoQA}}\", \"razonSocial\": \"QA TransAduanas\", \"correoContacto\": \"invalido\", \"esProspecto\": true, \"estadoCliente\": \"PROSPECTO\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Sin éxito\",()=>pm.expect(pm.response.json().success).to.eql(false));"
            ]
          }
        }
      ]
    },
    {
      "name": "CP23 Clientes sin token",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/clientes",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
              "pm.test(\"Sin éxito\",()=>pm.expect(pm.response.json().success).to.eql(false));"
            ]
          }
        }
      ]
    }
  ]
}