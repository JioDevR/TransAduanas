                  "pm.test(\"Verificación del caso\", () => { pm.expect(pm.response.json().data).to.equal(null); });"
                ]
              }
            }
          ]
        },
        {
          "name": "FE04 Usuario comercial por el proxy del SGA",
          "request": {
            "method": "GET",
            "url": "{{frontendUrl}}/api/v1/usuarios",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{mariaToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));",
