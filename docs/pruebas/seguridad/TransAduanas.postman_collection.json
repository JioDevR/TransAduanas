    {
      "name": "Base de datos por API",
      "item": [
        {
          "name": "BD01 Lectura del cliente sembrado",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/clientes/{{anaClientId}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{mariaToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Verificación del caso\", () => { const cliente = pm.response.json().data; pm.expect(cliente.idCliente).to.equal(Number(pm.environment.get('anaClientId'))); pm.expect(cliente.numeroDocumento).to.equal('20990000041'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "BD02 Alta duplicada",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/clientes",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{mariaToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"tipoDocumento\":\"RUC\",\"numeroDocumento\":\"20990000041\",\"razonSocial\":\"Transportes Costa del Sur S.A.C.\",\"correoContacto\":\"ana.torres@costadelsur.example\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Verificación del caso\", () => { pm.expect(pm.response.json().message).to.include('Ya existe un cliente'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "BD03 Alta desde cuenta del portal",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/clientes",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{anaToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"tipoDocumento\":\"RUC\",\"numeroDocumento\":\"20990000049\",\"razonSocial\":\"Servicios Brisa Sur S.A.C.\",\"correoContacto\":\"ventas@brisasur.example\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));",
                  "pm.test(\"Verificación del caso\", () => { pm.expect(pm.response.json().data).to.equal(null); });"
                ]
              }
            }
          ]
        },
        {
          "name": "BD04 Conteo posterior sin nuevas altas",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/clientes",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{mariaToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Verificación del caso\", () => { const clientes = pm.response.json().data; pm.expect(clientes).to.have.lengthOf(Number(pm.environment.get('expectedClients'))); pm.expect(clientes.some(c => c.numeroDocumento === '20990000049')).to.equal(false); });"
                ]
              }
            }
          ]
        }
      ]
    },
