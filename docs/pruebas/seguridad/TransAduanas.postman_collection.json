{
  "info": {
    "name": "TransAduanas - 4 casos de seguridad",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8085"
    }
  ],
  "item": [
    {
      "name": "PM01 Sin token",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/usuarios",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
              "pm.test(\"No entrega datos protegidos\", () => { pm.expect(pm.response.json().success).to.equal(false); pm.expect(pm.response.json().data).to.equal(null); });"
            ]
          }
        }
      ]
    },
    {
      "name": "PM02 JWT inválido",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/usuarios",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer not.a.jwt"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
              "pm.test(\"No entrega datos protegidos\", () => { pm.expect(pm.response.json().success).to.equal(false); pm.expect(pm.response.json().data).to.equal(null); });"
            ]
          }
        }
      ]
    },
    {
      "name": "PM03 Login incorrecto",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"admin\",\"password\":\"credencial-incorrecta-para-este-caso\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
              "pm.test(\"No entrega datos protegidos\", () => { pm.expect(pm.response.json().success).to.equal(false); pm.expect(pm.response.json().data).to.equal(null); });"
            ]
          }
        }
      ]
    },
    {
      "name": "PM04 Origen CORS ajeno",
      "request": {
        "method": "OPTIONS",
        "url": "{{baseUrl}}/api/v1/usuarios",
        "header": [
          {
            "key": "Origin",
            "value": "https://untrusted.example"
          },
          {
            "key": "Access-Control-Request-Method",
            "value": "GET"
          },
          {
            "key": "Access-Control-Request-Headers",
            "value": "Authorization"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));",
              "pm.test(\"El origen no recibe autorización CORS\", () => pm.expect(pm.response.headers.has(\"Access-Control-Allow-Origin\")).to.equal(false));"
            ]
          }
        }
      ]
    }
  ]
}
