{
  "info": {
    "name": "TransAduanas - Seguridad por componente",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Backend",
      "item": [
        {
          "name": "BE01 Ruta privada sin token",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/usuarios",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Verificación del caso\", () => { pm.expect(pm.response.json().data).to.equal(null); });"
                ]
              }
            }
          ]
        },
        {
          "name": "BE02 JWT inválido",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/usuarios",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer not.a.jwt"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Verificación del caso\", () => { pm.expect(pm.response.json().success).to.equal(false); });"
                ]
              }
            }
          ]
        },
        {
          "name": "BE03 Contraseña incorrecta",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"admin\",\"password\":\"credencial-incorrecta-para-este-caso\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Verificación del caso\", () => { pm.expect(pm.response.json().data).to.equal(null); });"
                ]
              }
            }
          ]
        },
        {
          "name": "BE04 Origen CORS externo",
          "request": {
            "method": "OPTIONS",
            "url": "{{baseUrl}}/api/v1/usuarios",
            "header": [
              {
                "key": "Origin",
                "value": "https://untrusted.example"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "GET"
              },
              {
                "key": "Access-Control-Request-Headers",
                "value": "Authorization"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));",
                  "pm.test(\"Verificación del caso\", () => { pm.expect(pm.response.headers.has('Access-Control-Allow-Origin')).to.equal(false); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Frontend",
      "item": [
        {
          "name": "FE01 Shell del login",
          "request": {
            "method": "GET",
            "url": "{{frontendUrl}}/login",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Verificación del caso\", () => { pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html'); pm.expect(pm.response.text()).to.include('<div id=\"app\"></div>'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "FE02 Ruta Finanzas entrega solo el shell",
          "request": {
            "method": "GET",
            "url": "{{frontendUrl}}/finanzas",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Verificación del caso\", () => { pm.expect(pm.response.text()).to.include('<div id=\"app\"></div>'); pm.expect(pm.response.text()).not.to.include('maria.salas'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "FE03 Login incorrecto por el proxy del SGA",
          "request": {
            "method": "POST",
            "url": "{{frontendUrl}}/api/v1/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"maria.salas\",\"password\":\"credencial-incorrecta-para-este-caso\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
