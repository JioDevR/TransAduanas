{
  "uid": "transaduanas-monitoreo",
  "title": "TransAduanas Monitoreo",
  "tags": [
    "transaduanas",
    "monitoreo"
  ],
  "timezone": "America/Lima",
  "schemaVersion": 39,
  "version": 3,
  "editable": false,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Recoleccion del backend",
      "description": "1 = Prometheus puede leer las metricas. No equivale a validar todas las funciones del negocio.",
      "datasource": {
        "type": "prometheus",
        "uid": "transaduanas-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"transaduanas-backend\"}",
          "legendFormat": "Recoleccion del backend",
          "datasource": {
            "type": "prometheus",
            "uid": "transaduanas-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Solicitudes acumuladas",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "transaduanas-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(http_server_requests_seconds_count{job=\"transaduanas-backend\",uri!~\"/actuator.*\"})",
          "legendFormat": "Solicitudes acumuladas",
          "datasource": {
            "type": "prometheus",
            "uid": "transaduanas-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
